+    /// (0.2.5) A scratch git repository with one commit of `app.txt` ("one\n").
+    fn git_repo(tag: &str) -> PathBuf {
+        let repo = scratch(tag);
+        let git = |a: &[&str]| {
+            let st = std::process::Command::new("git")
+                .arg("-C")
+                .arg(&repo)
+                .args(a)
+                .status()
+                .expect("git on PATH");
+            assert!(st.success(), "git {a:?} failed");
+        };
+        git(&["init", "-q"]);
+        git(&["config", "user.email", "t@e.com"]);
+        git(&["config", "user.name", "T"]);
+        std::fs::write(repo.join("app.txt"), "one\n").unwrap();
+        git(&["add", "-A"]);
+        git(&["commit", "-q", "-m", "init"]);
+        repo
+    }
+
+    /// (0.2.5, cases 1-4) `file_patch`: the header names the path (never the blob ids); a new
+    /// file diffs from /dev/null, a deleted one to /dev/null, a modified one hunk-by-hunk, and
+    /// an unchanged one is "".
