                                               "line":  93
                                           }
                                       ],
                         "claim":  "The telemetry spool can lose newly appended events because flush rewrites an earlier snapshot without synchronizing with producers.",
                         "trigger":  "A consultation or rating appends after flush reads spool.ndjson but before a successful POST causes flush to overwrite it; the stale-only clearing branch has the same race.",
                         "evidence":  [
                                          {
                                              "kind":  "read-code",
                                              "reference":  "crates/c3/src/telemetry/spool.rs: enqueue_line and flush",
                                              "observation":  "Enqueue appends directly. Flush reads the whole file, posts a batch, then uses fs::write with the remainder derived from that snapshot. No shared lock or generation check surrounds these operations."
                                          },
                                          {
                                              "kind":  "inferred",
                                              "reference":  "crates/c3/src/telemetry/spool.rs",
                                              "observation":  "An event appended between the read and rewrite is absent from the retained snapshot and is overwritten without being sent."
                                          }
                                      ],
                         "verification":  "Hold a local intake response after flush reads event A, append event B, return success, and assert B remains queued.",
                         "remedy":  "Use a synchronized durable outbox with atomic batch ownership and crash recovery; coordinate append, flush, and forgetting before adding the new rating delivery paths.",
                         "supersedes":  [

                                        ],
                         "superseded_by":  [

                                           ],
