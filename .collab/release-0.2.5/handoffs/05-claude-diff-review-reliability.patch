+        }
+        let when = c.get("when").and_then(|v| v.as_str()).unwrap_or("");
+        let in_window = DateTime::parse_from_rfc3339(when)
+            .map(|d| {
+                let w = d.with_timezone(&Utc);
+                w >= cutoff && w <= now
+            })
+            .unwrap_or(false);
+        if !in_window {
