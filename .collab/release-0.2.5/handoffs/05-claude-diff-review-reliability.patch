+            continue;
+        }
+        let e = by
+            .entry((provider.clone(), model.clone()))
+            .or_insert_with(|| ReplyOutcomes {
+                provider,
+                model,
+                ..Default::default()
+            });
+        if usable {
+            e.usable += 1;
+        } else if has_reply {
+            e.failed_with_reply += 1;
+        } else {
+            e.failed_no_reply += 1;
+        }
+    }
+    by.into_values().collect()
+}
