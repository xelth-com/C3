+        "{out}"
+    );
+    assert_eq!(std::fs::read_to_string(&outside).unwrap(), old);
+    assert_eq!(std::fs::read_to_string(&rule).unwrap(), old);
+    let _ = std::fs::remove_dir_all(&base);
+}
