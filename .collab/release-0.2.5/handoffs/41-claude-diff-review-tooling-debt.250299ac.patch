+fn branch_exists(repo: &Path, b: &str) -> bool {
+    Command::new("git")
+        .arg("-C")
+        .arg(repo)
+        .args([
+            "show-ref",
+            "--verify",
+            "--quiet",
+            &format!("refs/heads/{b}"),
+        ])
+        .status()
+        .map(|s| s.success())
+        .unwrap_or(false)
