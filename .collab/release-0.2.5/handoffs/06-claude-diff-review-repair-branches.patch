+        (true, false) => Some(format!(
+            "c3: model settings NOT refreshed in this repository - {failed}"
+        )),
+        (false, false) => Some(format!(
+            "c3: model settings refreshed in this repository - {fixed} (left uncommitted); NOT refreshed - {failed}"
+        )),
+    }
