+fn throwaway_stale_reason(path: &Path, now: SystemTime) -> Option<String> {
+    let meta = std::fs::metadata(path).ok();
+    let owner = worktree_admin_dir(path)
+        .and_then(|a| std::fs::read_to_string(a.join(THROWAWAY_OWNER_FILE)).ok())
