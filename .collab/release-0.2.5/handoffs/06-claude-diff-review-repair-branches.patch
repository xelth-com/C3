+    let age = meta.as_ref().and_then(|m| {
+        let newest = [m.created().ok(), m.modified().ok()]
+            .into_iter()
+            .flatten()
+            .max()?;
+        Some(now.duration_since(newest).unwrap_or_default())
+    });
+    stale_verdict(meta.is_some(), owner, crate::liveness::proc::pid_alive, age)
