+    if !dir_exists {
+        return Some("its directory is gone".to_string());
+    }
+    match owner {
+        Some((pid, start)) => {
+            (!owner_alive(pid, &start)).then(|| format!("the run that made it (pid {pid}) is gone"))
+        }
+        None => age
+            .filter(|a| *a > STALE_AFTER)
+            .map(|a| format!("no owner record and {} h old", a.as_secs() / 3600)),
+    }
