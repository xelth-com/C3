+        // a same-origin hop is followed, a userinfo hop is refused before it is requested
+        let mut asked: Vec<String> = Vec::new();
+        let r = fetch::<&[u8]>(
+            "https://catalog.example/m",
+            policy(5_000, Redirects::SameOrigin, 100),
+            |u, _| {
+                asked.push(u.to_string());
