+        let r = fetch::<&[u8]>(
+            "https://u:p@catalog.example/m",
+            policy(5_000, Redirects::SameOrigin, 100),
+            |u, _| {
+                asked.push(u.to_string());
+                Ok(Hop::Status(500))
+            },
+        );
