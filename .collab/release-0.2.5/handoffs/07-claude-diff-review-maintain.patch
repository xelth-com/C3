+                    _ => Hop::Redirect("https://x:y@catalog.example/m3".into()),
+                })
+            },
+        );
+        assert!(r.unwrap_err().contains("credentials"));
+        assert_eq!(
+            asked,
+            vec!["https://catalog.example/m", "https://catalog.example/m2"]
+        );
