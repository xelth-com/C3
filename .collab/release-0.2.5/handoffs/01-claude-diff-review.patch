+    let Some(m) = parse_model_id(model) else {
+        return false;
+    };
+    !m.prefix.is_empty()
+        && list.iter().any(|l| {
+            parse_model_id(l).is_some_and(|p| {
+                p.prefix == m.prefix && p.suffix == m.suffix && m.version() >= p.version()
+            })
+        })
+}
