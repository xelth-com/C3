+            std::thread::spawn(move || with_scan_children(bound, || run_registered(sleeper())));
+        let until = std::time::Instant::now() + Duration::from_secs(20);
+        let pid = loop {
+            if let Some(p) = set.running_pids().first() {
+                break *p;
+            }
+            assert!(
