+/// The hook's gate files under the isolated codex home (`ci-check-<16 hex>.json`).
+fn gate_files(e: &Env) -> Vec<String> {
+    std::fs::read_dir(e.home.join("c3"))
+        .map(|d| {
+            d.flatten()
+                .map(|x| x.file_name().to_string_lossy().to_string())
