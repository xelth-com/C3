+    /// `Err` says why it was not taken (held by another process, or the file could not be created).
+    pub fn acquire(repo_root: &Path, purpose: &str) -> Result<MoveLock, String> {
+        Self::acquire_within(repo_root, purpose, lock_wait())
+    }
