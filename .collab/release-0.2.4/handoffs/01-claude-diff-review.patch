new file mode 100644
index 0000000..000e5e9
--- /dev/null
+++ b/crates/c3/src/maintain/engine.rs
@@ -0,0 +1,330 @@
+//! Per-engine maintenance adapters: how each CLI reports its installed version, how its latest
+//! version is learned, and how it is updated and rolled back. The real command shapes were
+//! confirmed against the installed CLIs (2026-11):
+//!
+//! * **codex** — npm global `@openai/codex`. Latest: `npm view @openai/codex version` (release date
+//!   from `npm view @openai/codex time --json`); update `npm install -g @openai/codex@<v>`; rollback
+//!   the same to the previous version. Only when codex is an npm global install; otherwise
+//!   report-only. (The CLI also has a `codex update`, but the design pins the npm path so the
+//!   rollback is deterministic.)
+//! * **grok** — `grok update --check --json` → `{currentVersion,latestVersion,updateAvailable,…}`;
+//!   update `grok update`; rollback `grok update --version <prev>` (the `--version` pin exists, so
+//!   grok has a rollback path).
+//! * **kimi** — no self-update subcommand; the vendor installer. Latest: GET
+//!   `https://code.kimi.ai/kimi-code/latest`. Update: download `install.ps1` (Windows) / `install.sh`
+//!   (POSIX) over https to the state dir and run it; `KIMI_VERSION=<v>` pins, which is the rollback.
+//! * **agy** — `agy update` self-updates, but `agy update --help` exposes no check and no version
+//!   pin, so there is no way to learn the latest beforehand and no rollback: report-only.
+//! * **muse / claude** — both update themselves (claude is also the coordinator host): the version is
+//!   recorded, never updated.
+
+use std::path::Path;
+
+use chrono::{DateTime, Utc};
+
+use super::env::{Env, RunResult};
+use super::version::{parse_cli_version, CliVersion};
+
+/// What a maintenance pass may do with an engine.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Caps {
+    /// The engine can be updated at all (false for muse/claude: record-only).
+    pub updatable: bool,
+    /// The latest version can be learned before installing (false for agy: no check command).
+    pub has_check: bool,
+    /// A specific previous version can be reinstalled (false for agy).
+    pub has_rollback: bool,
+}
+
+/// The engines a pass walks, in order.
+pub const ENGINES: &[&str] = &["codex", "grok", "kimi", "agy", "muse", "claude"];
+
+/// Resolve `npm` to a runnable launcher. On Windows the node install ships `npm.ps1`, `npm.cmd`
+/// and an extensionless `npm` (a bash script) in the same directory; `CreateProcess`/`Command`
+/// cannot run the `.ps1` or the extensionless shell script, so we must pick `npm.cmd` (or `npm.exe`)
+/// explicitly - the bare name would resolve to the first file, the unrunnable `npm`. Falls back to
+/// the bare name elsewhere.
+fn npm() -> String {
+    if cfg!(windows) {
+        for n in ["npm.cmd", "npm.exe", "npm.bat"] {
+            if let Some(p) = crate::providers::find_on_path(n) {
+                return p;
+            }
+        }
+    }
+    crate::providers::find_on_path("npm").unwrap_or_else(|| "npm".to_string())
+}
+
+/// The maintenance capabilities of an engine (an unknown name is record-only).
+pub fn caps(name: &str) -> Caps {
+    match name {
+        "codex" | "grok" | "kimi" => Caps {
+            updatable: true,
+            has_check: true,
+            has_rollback: true,
+        },
+        "agy" => Caps {
+            updatable: true,
+            has_check: false,
+            has_rollback: false,
+        },
+        // muse and claude update themselves; C3 records the version and never updates.
+        _ => Caps {
+            updatable: false,
+            has_check: false,
+            has_rollback: false,
+        },
+    }
+}
+
+/// Resolve the engine's launcher exactly as the engine does (`None`/`""` → not installed).
+pub fn resolve_launcher(name: &str) -> Option<String> {
+    match crate::providers::resolve_engine_launcher(name, "") {
+        Ok(Some(l)) if !l.is_empty() => Some(l),
+        _ => None,
+    }
+}
+
+/// The installed version from `<launcher> --version` (first semver-like token), or `None`.
+pub fn installed_version(env: &dyn Env, launcher: &str) -> Option<CliVersion> {
+    let r = env.run(launcher, &["--version"], &[], None);
+    parse_cli_version(&r.combined())
+}
+
+/// What a check learned about the latest available version.
+#[derive(Debug, Clone, Default)]
+pub struct Latest {
+    /// The latest version string (e.g. `0.170.0`), or `None` when it could not be learned.
+    pub version: Option<CliVersion>,
+    /// The release date of `version` when it can be known (npm `time`); else `None`.
+    pub released: Option<DateTime<Utc>>,
+    /// A one-line note when no check is possible (report-only engines); else `""`.
+    pub note: String,
+}
+
+/// Learn the latest available version for `name`.
+pub fn check_latest(env: &dyn Env, name: &str, launcher: &str) -> Latest {
+    match name {
+        "codex" => check_codex(env, launcher),
+        "grok" => check_grok(env, launcher),
+        "kimi" => check_kimi(env),
+        _ => Latest {
+            note: "no check command".to_string(),
+            ..Default::default()
+        },
+    }
+}
+
+fn check_codex(env: &dyn Env, launcher: &str) -> Latest {
+    if !codex_is_npm_global(env, launcher) {
+        return Latest {
+            note: "not an npm global install - report only".to_string(),
+            ..Default::default()
+        };
+    }
+    let ver = env.run(&npm(), &["view", "@openai/codex", "version"], &[], None);
+    if !ver.ok() {
+        return Latest {
+            note: format!("npm view failed ({})", ver.fail_reason()),
+            ..Default::default()
+        };
+    }
+    let version = parse_cli_version(ver.stdout.trim());
+    if version.is_none() {
+        return Latest {
+            note: "npm view returned no version".to_string(),
+            ..Default::default()
+        };
+    }
+    let released = version.as_ref().and_then(|v| {
+        let out = env.run(&npm(), &["view", "@openai/codex", "time", "--json"], &[], None);
+        if !out.ok() {
+            return None;
+        }
+        let data: serde_json::Value = serde_json::from_str(out.stdout.trim()).ok()?;
+        let stamp = data.get(v.text()).and_then(|x| x.as_str())?;
+        DateTime::parse_from_rfc3339(stamp)
+            .ok()
+            .map(|d| d.with_timezone(&Utc))
+    });
+    Latest {
+        version,
+        released,
+        note: String::new(),
+    }
+}
+
+/// Whether the installed codex is an npm global package (so the npm update/rollback path applies).
+fn codex_is_npm_global(env: &dyn Env, launcher: &str) -> bool {
+    let lower = launcher.to_ascii_lowercase();
+    if lower.contains("node_modules") || lower.replace('\\', "/").contains("/npm/") {
+        return true;
+    }
+    let r = env.run(&npm(), &["ls", "-g", "@openai/codex"], &[], None);
+    r.ok() && r.stdout.contains("@openai/codex@")
+}
+
+fn check_grok(env: &dyn Env, launcher: &str) -> Latest {
+    let r = env.run(launcher, &["update", "--check", "--json"], &[], None);
+    if !r.ok() {
+        return Latest {
+            note: "grok update --check failed".to_string(),
+            ..Default::default()
+        };
+    }
+    let data: serde_json::Value = match serde_json::from_str(r.stdout.trim()) {
+        Ok(v) => v,
+        Err(_) => {
+            return Latest {
+                note: "grok update --check gave no JSON".to_string(),
+                ..Default::default()
+            }
+        }
+    };
+    let version = data
+        .get("latestVersion")
+        .and_then(|v| v.as_str())
+        .and_then(parse_cli_version);
+    Latest {
+        version,
+        released: None,
+        note: String::new(),
+    }
+}
+
+/// The kimi latest-version marker URL (the vendor installer's `latest` sibling).
+pub const KIMI_LATEST_URL: &str = "https://code.kimi.ai/kimi-code/latest";
+/// The kimi vendor installer URL (Windows).
+pub const KIMI_INSTALL_PS1: &str = "https://code.kimi.ai/kimi-code/install.ps1";
+/// The kimi vendor installer URL (POSIX).
+pub const KIMI_INSTALL_SH: &str = "https://code.kimi.ai/kimi-code/install.sh";
+
+fn check_kimi(env: &dyn Env) -> Latest {
+    match env.http_get(KIMI_LATEST_URL, &[], std::time::Duration::from_secs(5), true) {
+        // The marker answers 200 with the bare version and no text content-type, so the body is
+        // read as bytes (via http_get) and trimmed before validating it is a version.
+        Ok((status, body)) if (200..300).contains(&status) => match parse_cli_version(body.trim()) {
+            Some(v) => Latest {
+                version: Some(v),
+                released: None,
+                note: String::new(),
+            },
+            None => Latest {
+                note: "the kimi latest marker was not a version".to_string(),
+                ..Default::default()
+            },
+        },
+        Ok((status, _)) => Latest {
+            note: format!("the kimi latest marker returned {status}"),
+            ..Default::default()
+        },
+        Err(e) => Latest {
+            note: format!("the kimi latest marker could not be read ({e})"),
+            ..Default::default()
+        },
+    }
+}
+
+/// Run the update of `name` to `to` (a version string). Returns the command's result, or `Err`
+/// with a one-line reason when the update could not even be launched.
+pub fn do_update(
+    env: &dyn Env,
+    name: &str,
+    launcher: &str,
+    to: &str,
+    state_dir: &Path,
+) -> Result<RunResult, String> {
+    match name {
+        "codex" => Ok(env.run(
+            &npm(),
+            &["install", "-g", &format!("@openai/codex@{to}")],
+            &[],
+            None,
+        )),
+        "grok" => Ok(env.run(launcher, &["update"], &[], None)),
+        "kimi" => run_kimi_installer(env, state_dir, Some(to)),
+        other => Err(format!("{other} has no update path")),
+    }
+}
+
+/// Roll `name` back to the previous version `to`. `None` when the engine has no rollback path.
+pub fn do_rollback(
+    env: &dyn Env,
+    name: &str,
+    launcher: &str,
+    to: &str,
+    state_dir: &Path,
+) -> Option<Result<RunResult, String>> {
+    match name {
+        "codex" => Some(Ok(env.run(
+            &npm(),
+            &["install", "-g", &format!("@openai/codex@{to}")],
+            &[],
+            None,
+        ))),
+        "grok" => Some(Ok(env.run(launcher, &["update", "--version", to], &[], None))),
+        "kimi" => Some(run_kimi_installer(env, state_dir, Some(to))),
+        _ => None,
+    }
+}
+
+/// Download the kimi vendor installer over https to the state dir and run it, pinning `version`
+/// through `KIMI_VERSION` when given. Windows uses `install.ps1` via powershell; POSIX uses
+/// `install.sh` via sh.
+fn run_kimi_installer(
+    env: &dyn Env,
+    state_dir: &Path,
+    version: Option<&str>,
+) -> Result<RunResult, String> {
+    let (url, file, program): (&str, &str, &str) = if cfg!(windows) {
+        (KIMI_INSTALL_PS1, "kimi-install.ps1", "powershell")
+    } else {
+        (KIMI_INSTALL_SH, "kimi-install.sh", "sh")
+    };
+    let (status, body) = env
+        .http_get(url, &[], std::time::Duration::from_secs(30), true)
+        .map_err(|e| format!("could not download the kimi installer ({e})"))?;
+    if !(200..300).contains(&status) {
+        return Err(format!("the kimi installer download returned {status}"));
+    }
+    let script = state_dir.join(file);
+    // The vendor script is UTF-8 without a byte-order mark and carries a few non-ASCII characters.
+    // Windows PowerShell 5.1 reads such a `-File` in the ANSI code page, where the bytes of a dash
+    // turn into a quote character and can break the parse - so the mark is added on Windows.
+    let mut bytes: Vec<u8> = Vec::with_capacity(body.len() + 3);
+    if cfg!(windows) && !body.starts_with('\u{feff}') {
+        bytes.extend_from_slice(&[0xEF, 0xBB, 0xBF]);
+    }
+    bytes.extend_from_slice(body.as_bytes());
+    std::fs::write(&script, &bytes)
+        .map_err(|e| format!("could not write the kimi installer ({e})"))?;
+    let script_s = script.to_string_lossy().to_string();
+    let pin: Vec<(&str, &str)> = version.map(|v| vec![("KIMI_VERSION", v)]).unwrap_or_default();
+    let args: Vec<&str> = if cfg!(windows) {
+        vec![
+            "-NoProfile",
+            "-ExecutionPolicy",
+            "Bypass",
+            "-File",
+            &script_s,
+        ]
+    } else {
+        vec![script_s.as_str()]
+    };
+    Ok(env.run(program, &args, &pin, Some(state_dir)))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn caps_per_engine() {
+        assert!(caps("codex").has_rollback);
+        assert!(caps("grok").has_rollback);
+        assert!(caps("kimi").has_rollback);
+        assert!(caps("agy").updatable && !caps("agy").has_check && !caps("agy").has_rollback);
+        assert!(!caps("muse").updatable);
+        assert!(!caps("claude").updatable);
+    }
+}
diff --git a/crates/c3/src/maintain/env.rs b/crates/c3/src/maintain/env.rs
new file mode 100644
index 0000000..552c641
--- /dev/null
+++ b/crates/c3/src/maintain/env.rs
@@ -0,0 +1,224 @@
+//! The single injected seam between `c3 maintain` and the outside world: running a CLI and making
+//! an HTTP GET. Production uses [`SystemEnv`]; the unit tests script a fake so no pass ever touches
+//! a real CLI, the network or a model. Every external command of a pass goes through [`Env::run`],
+//! every model-list HTTP read through [`Env::http_get`].
+
+use std::path::Path;
+use std::time::Duration;
+
+/// The result of running a CLI: the exit code (`None` on a signal / spawn failure) and the captured
+/// output. `ok()` is "exited 0".
+#[derive(Debug, Clone, Default)]
+pub struct RunResult {
+    pub code: Option<i32>,
+    pub stdout: String,
+    pub stderr: String,
+}
+
+impl RunResult {
+    pub fn ok(&self) -> bool {
+        self.code == Some(0)
+    }
+
+    /// stdout and stderr joined (for a version/model probe that may print to either).
+    pub fn combined(&self) -> String {
+        if self.stderr.trim().is_empty() {
+            self.stdout.clone()
+        } else if self.stdout.trim().is_empty() {
+            self.stderr.clone()
+        } else {
+            format!("{}\n{}", self.stdout, self.stderr)
+        }
+    }
+
+    /// A one-line failure reason (the first non-empty stderr line, else stdout, else the code).
+    pub fn fail_reason(&self) -> String {
+        let pick = |s: &str| {
+            s.lines()
+                .map(str::trim)
+                .find(|l| !l.is_empty())
+                .map(|l| l.to_string())
+        };
+        pick(&self.stderr)
+            .or_else(|| pick(&self.stdout))
+            .unwrap_or_else(|| match self.code {
+                Some(c) => format!("exit {c}"),
+                None => "the command did not complete".to_string(),
+            })
+    }
+}
+
+/// The outside world a maintenance pass talks to. Both methods are best-effort and never panic.
+pub trait Env {
+    /// Run `program` with `args`, extra `env` pairs set on top of the inherited environment, in
+    /// `cwd` (or the current directory). Never inherits the coordinator's host markers.
+    fn run(&self, program: &str, args: &[&str], env: &[(&str, &str)], cwd: Option<&Path>)
+        -> RunResult;
+
+    /// A plain HTTPS GET with the given request `headers`, returning `(status, body)` or an error.
+    /// Used for the model-list endpoints and the kimi `latest` marker; failures are ignored by the
+    /// caller. `follow_redirects` is set only for KEYLESS public GETs (the kimi marker/installer,
+    /// which a CDN redirects by region) - NEVER for a request that carries an API key, so a key is
+    /// never forwarded to a redirect target.
+    fn http_get(
+        &self,
+        url: &str,
+        headers: &[(&str, &str)],
+        timeout: Duration,
+        follow_redirects: bool,
+    ) -> Result<(u16, String), String>;
+}
+
+/// The production environment: a real `std::process::Command` (host markers scrubbed from the
+/// child, exactly as the engine launchers scrub them) and a real ureq GET (`https` only, no
+/// redirects).
+pub struct SystemEnv;
+
+impl Env for SystemEnv {
+    fn run(
+        &self,
+        program: &str,
+        args: &[&str],
+        env: &[(&str, &str)],
+        cwd: Option<&Path>,
+    ) -> RunResult {
+        let mut cmd = std::process::Command::new(program);
+        cmd.args(args);
+        if let Some(d) = cwd {
+            cmd.current_dir(d);
+        }
+        for (k, v) in env {
+            cmd.env(k, v);
+        }
+        crate::engines::scrub_host_markers(&mut cmd);
+        match cmd.output() {
+            Ok(out) => RunResult {
+                code: out.status.code(),
+                stdout: String::from_utf8_lossy(&out.stdout).into_owned(),
+                stderr: String::from_utf8_lossy(&out.stderr).into_owned(),
+            },
+            Err(e) => RunResult {
+                code: None,
+                stdout: String::new(),
+                stderr: c3_core::one_line(&e.to_string()),
+            },
+        }
+    }
+
+    fn http_get(
+        &self,
+        url: &str,
+        headers: &[(&str, &str)],
+        timeout: Duration,
+        follow_redirects: bool,
+    ) -> Result<(u16, String), String> {
+        if !url.starts_with("https://") {
+            return Err("only https is allowed".to_string());
+        }
+        // Redirects are followed by hand, never by ureq: every hop must stay on https and on the
+        // site the request started from (`code.kimi.ai` -> `cdn.kimi.ai`), so a redirect can
+        // neither downgrade the transport nor hand a download - the kimi installer script is run
+        // after it is fetched - to another site.
+        let agent = ureq::AgentBuilder::new()
+            .timeout_connect(timeout)
+            .timeout(timeout)
+            .redirects(0)
+            .build();
+        let ua = format!("c3/{}", env!("CARGO_PKG_VERSION"));
+        let mut current = url.to_string();
+        let mut hops = 0;
+        loop {
+            let mut req = agent.get(&current).set("User-Agent", &ua);
+            for (k, v) in headers {
+                req = req.set(k, v);
+            }
+            match req.call() {
+                Ok(resp) => {
+                    let status = resp.status();
+                    if follow_redirects && matches!(status, 301 | 302 | 303 | 307 | 308) {
+                        hops += 1;
+                        if hops > MAX_REDIRECTS {
+                            return Err("too many redirects".to_string());
+                        }
+                        current = redirect_target(&current, resp.header("location").unwrap_or(""))?;
+                        continue;
+                    }
+                    // Read the body as bytes and lossily decode: the kimi `latest` marker answers
+                    // with no text content-type, which `into_string()` can choke on. 1 MiB cap.
+                    let mut buf: Vec<u8> = Vec::new();
+                    use std::io::Read as _;
+                    let _ = resp.into_reader().take(1_000_000).read_to_end(&mut buf);
+                    return Ok((status, String::from_utf8_lossy(&buf).into_owned()));
+                }
+                Err(ureq::Error::Status(code, _)) => return Ok((code, String::new())),
+                Err(e) => return Err(c3_core::one_line(&e.to_string())),
+            }
+        }
+    }
+}
+
+/// How many redirects a keyless GET follows.
+const MAX_REDIRECTS: u32 = 3;
+
+/// The URL a redirect from `from` to `location` leads to, or why it is refused: the target must be
+/// https and on the same site as `from` (the same last two host labels, `code.kimi.ai` ->
+/// `cdn.kimi.ai`). A relative `location` is resolved against `from`.
+pub(crate) fn redirect_target(from: &str, location: &str) -> Result<String, String> {
+    let location = location.trim();
+    if location.is_empty() {
+        return Err("a redirect without a location".to_string());
+    }
+    let base = url::Url::parse(from).map_err(|e| format!("bad url: {e}"))?;
+    let next = base
+        .join(location)
+        .map_err(|e| format!("bad redirect location: {e}"))?;
+    if next.scheme() != "https" {
+        return Err(format!("refused a redirect to {}", next.scheme()));
+    }
+    let site = |u: &url::Url| -> String {
+        let host = u.host_str().unwrap_or("").to_ascii_lowercase();
+        let labels: Vec<&str> = host.rsplit('.').take(2).collect();
+        labels.into_iter().rev().collect::<Vec<_>>().join(".")
+    };
+    if site(&base).is_empty() || site(&base) != site(&next) {
+        return Err(format!(
+            "refused a redirect to another site ({})",
+            next.host_str().unwrap_or("?")
+        ));
+    }
+    Ok(next.to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::redirect_target;
+
+    #[test]
+    fn a_redirect_stays_on_https_and_on_the_same_site() {
+        assert_eq!(
+            redirect_target(
+                "https://code.kimi.ai/kimi-code/latest",
+                "https://cdn.kimi.ai/kimi-code/latest"
+            )
+            .unwrap(),
+            "https://cdn.kimi.ai/kimi-code/latest"
+        );
+        // a relative location is resolved against the request
+        assert_eq!(
+            redirect_target("https://code.kimi.ai/kimi-code/latest", "/v2/latest").unwrap(),
+            "https://code.kimi.ai/v2/latest"
+        );
+        // a transport downgrade, another site and an empty location are refused
+        assert!(redirect_target(
+            "https://code.kimi.ai/kimi-code/install.ps1",
+            "http://cdn.kimi.ai/kimi-code/install.ps1"
+        )
+        .is_err());
+        assert!(redirect_target(
+            "https://code.kimi.ai/kimi-code/install.ps1",
+            "https://cdn.example.net/kimi-code/install.ps1"
+        )
+        .is_err());
+        assert!(redirect_target("https://code.kimi.ai/kimi-code/latest", "  ").is_err());
+    }
+}
