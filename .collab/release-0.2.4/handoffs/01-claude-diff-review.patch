+          {"provider":"b","model":"m1"}
+        ]}"#;
+        // same model string in two entries → provider disambiguates
+        let out = replace_entry_model(text, "b", "m1", "m2").unwrap();
+        assert_eq!(out.matches("\"model\":\"m2\"").count(), 1);
+        assert!(out.contains("{\"provider\":\"b\",\"model\":\"m2\"}"));
